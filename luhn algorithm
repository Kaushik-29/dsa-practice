#include <iostream>
#include <vector>
using namespace std;

bool check(vector<int> arr){
    int sum=0;
    int n=arr.size();
    int start=n%2;
    for(int i=0;i<n;i++){
        if(i%2==start){
            arr[i]*=2;
            if(arr[i]>9){
                arr[i]-=9;
            }
        }
        
            sum=arr[i]+sum;
    }
    
    return (sum%10==0);
}



int main(){
    vector<int> card;

 string s;
    cout << "Enter your card number:\n";
    cin >> s;

    for(char c : s){
        card.push_back(c - '0');
    }
    
    
    
    if(check(card)){
        cout<<"Valid";
    }
    else{
        cout<<"invalid";
    }
    
    
    
    return 0;
    
}
